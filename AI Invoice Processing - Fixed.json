        "jsCode": "// Sanitize and structure data for Sheets and Streamlit\nconst aiOutput = $input.first().json.output || $input.first().json;\n\nconst formattedData = {\n  vendor_name: aiOutput.vendor_name || \"Unknown Vendor\",\n  invoice_number: aiOutput.invoice_number || \"INV-N/A\",\n  invoice_date: aiOutput.invoice_date || new Date().toISOString().split('T')[0],\n  total_amount: parseFloat(aiOutput.total_amount || 0),\n  tax_amount: parseFloat(aiOutput.tax_amount || 0),\n  category: aiOutput.category || \"General Expense\",\n  line_items: aiOutput.line_items || [],\n  processed_at: new Date().toISOString()\n};\n\nreturn { json: formattedData };"
      },
